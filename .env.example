POSTGRES_DB=drafo
POSTGRES_USER=drafo
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://drafo:changeme@db:5432/drafo

DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

PUBLIC_BASE_URL=http://localhost:3000

# Production only -- the droplet's own hostname, used by the healthcheck
# and by Django's ALLOWED_HOSTS. No scheme.
BACKEND_HOST=api.example.com
MAX_UPLOAD_MB=25

# Email (prod only; dev uses the console backend)
DEFAULT_FROM_EMAIL=Drafo <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
